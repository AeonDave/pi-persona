{
  "name": "pi-persona",
  "version": "1.15.1",
  "private": false,
  "type": "module",
  "description": "Unified Pi extension: switchable supervisor personas with a clear orchestration grammar (opportunistic delegation or mandatory multi-agent strategies), file-based strategies on a core SDK, cross-OS. Replaces pi-subagents + pi-subagents-comtac + pi-subagents-persona.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "persona",
    "subagents",
    "orchestration",
    "multi-agent",
    "supervisor"
  ],
  "license": "MIT",
  "files": [
    "src",
    "personas",
    "agents",
    "prompts",
    "flows",
    "contracts",
    "presets",
    "docs",
    "assets",
    "scripts",
    "teams.yaml",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup/hermetic-env.ts --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --import ./test/setup/hermetic-env.ts --test \"test/unit/**/*.test.ts\"",
    "drive": "node --import tsx scripts/drive.ts",
    "smoke:exocom": "node --import tsx scripts/exocom-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.83.0",
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@earendil-works/pi-tui": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
